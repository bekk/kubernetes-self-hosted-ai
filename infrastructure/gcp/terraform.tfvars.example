# ──────────────────────────────────────────────────────────────────────────────
# Infrastructure variables
# ──────────────────────────────────────────────────────────────────────────────
#   cp terraform.tfvars.example terraform.tfvars
#
# Models are NOT configured here — edit ../../models.yaml instead.
# ──────────────────────────────────────────────────────────────────────────────

project_id   = "my-gcp-project-id" # ← replace with your GCP project ID
region       = "us-east5"   # TPU v6e; see variables.tofu for GPU zones
zone         = "us-east5-a"
cluster_name = "ai-datacenter"

# Lock the Kubernetes API down to your office / VPN egress IPs.
# authorized_networks = ["203.0.113.0/24"]

